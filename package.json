{
  "name": "tweb",
  "version": "1.0.0",
  "description": "Telegram Web K - Desktop Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "start:codespaces": "TWEB_PREVIEW=1 bash scripts/start-vite-preview.sh 8080",
    "start:cinema-preview": "TWEB_PREVIEW=1 bash scripts/start-vite-preview.sh 4173",
    "start-in-docker": "vite --host",
    "serve": "pnpm run build && node server.js --dist",
    "build": "vite build",
    "check-bundle": "node scripts/check-bundle-mangling.mjs dist",
    "test": "vitest",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:a11y:full": "A11Y_ALL_THEMES=1 playwright test --config playwright.a11y.config.ts",
    "test:ephemeral-bot": "node ./src/tests/fixtures/ephemeralBot/bot.mjs",
    "test:lottie": "playwright test e2e/lottie*.spec.ts",
    "test:popups": "playwright test --config=playwright.popups.config.ts",
    "test:popups:full": "POPUPS_ALL_ENGINES=1 playwright test --config=playwright.popups.config.ts",
    "test:editor:e2e": "playwright test --config=playwright.editor.config.ts",
    "test:focus": "playwright test --config=playwright.focus.config.ts",
    "test:focus:app": "playwright test e2e/focusPixelsApp.spec.ts",
    "test:a11y:app": "playwright test e2e/accessibilitySignedIn.spec.ts",
    "whybundled": "pnpm run profile && whybundled stats.json",
    "generate-mtproto-types": "node ./src/scripts/generate_mtproto_types.js src/",
    "generate-changelog": "node ./src/scripts/generate_changelog.js",
    "generate-icons": "node ./src/scripts/icomoon/icomoon_generate.js",
    "generate-emoji-skin-tones": "node ./src/scripts/generate_emoji_skin_tones.js",
    "change-version": "node ./src/scripts/change_version.js",
    "apply-new-lang": "node ./src/scripts/apply_new_lang.js",
    "watch-lang": "node watch-lang.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "node scss-types.js && tsc --noEmit",
    "typecheck:watch": "node scss-types.js && tsc --noEmit --watch",
    "build:solid": "node ./src/scripts/build_solid.js",
    "format-lang": "node ./src/scripts/format_lang.js",
    "lottie-to-svg": "node ./src/scripts/lottie_to_svg.js",
    "generate-scss-types": "node scss-types.js",
    "electron:dev": "concurrently -k -p '[{name}]' -c yellow,blue 'pnpm run start' 'wait-on http://localhost:8080 && cross-env IS_DEV=true NODE_ENV=development electron dist-electron/main.js'",
    "electron:dev:cinema": "concurrently -k -p '[{name}]' -c yellow,blue 'pnpm run start:cinema-preview' 'wait-on http://localhost:4173 && cross-env IS_DEV=true NODE_ENV=development ENTRY_POINT=cinema.html electron dist-electron/main.js'",
    "electron:build": "pnpm run build && pnpm run build:electron && electron-builder build --windows --x64 --nsis --one-click --per-machine",
    "electron:build:win": "pnpm run build && pnpm run build:electron && electron-builder build --windows --x64",
    "electron:build:mac": "pnpm run build && pnpm run build:electron && electron-builder build --mac --x64",
    "electron:build:linux": "pnpm run build && pnpm run build:electron && electron-builder build --linux --x64",
    "electron:build:all": "pnpm run build && pnpm run build:electron && electron-builder build --windows --mac --linux",
    "electron:build:dir": "pnpm run build && pnpm run build:electron",
    "build:electron": "tsx scripts/build-electron.ts",
    "electron:package": "pnpm run build && pnpm run build:electron && electron-builder build --windows --x64 --dir",
    "electron:start": "cross-env IS_DEV=true NODE_ENV=development electron dist-electron/main.js",
    "electron:start:cinema": "cross-env IS_DEV=true NODE_ENV=development ENTRY_POINT=cinema.html electron dist-electron/main.js"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@cryptography/aes": "^0.1.1",
    "@cryptography/sha1": "^0.2.0",
    "@cryptography/sha256": "^0.2.0",
    "@peculiar/webcrypto": "^1.7.1",
    "@playwright/test": "^1.61.1",
    "@solid-primitives/refs": "^1.1.4",
    "@solid-primitives/transition-group": "^1.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/aes-js": "^3.1.4",
    "@types/chrome": "0.2.2",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/prismjs": "^1.26.6",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "aes-js": "^3.1.2",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.11.4",
    "big-integer": "^1.6.52",
    "browserslist": "^4.28.7",
    "compression": "^1.8.1",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "csstype": "^3.2.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "0.27.4",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "11.12.0",
    "hls.js": "^1.6.16",
    "http-proxy": "^1.18.1",
    "js-md5": "^0.9.2",
    "jsdom": "^29.1.1",
    "libsodium-wrappers": "^0.8.4",
    "mediabunny": "^1.50.9",
    "mime": "^4.1.0",
    "node-ssh": "^13.2.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pngjs": "^7.0.0",
    "prismjs": "^1.30.0",
    "qr-code-styling": "^1.9.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.3",
    "tinyld": "^1.3.4",
    "tsx": "^4.19.2",
    "typed-scss-modules": "8.1.1",
    "vite": "^8.2.1",
    "vite-plugin-handlebars": "^2.0.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5",
    "ws": "^8.21.1"
  },
  "packageManager": "pnpm@11.16.0",
  "build": {
    "appId": "com.tweb.desktop",
    "productName": "Telegram Web K",
    "files": [
      "dist/**/*",
      "public/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "index.html",
      "cinema.html",
      "rewards-preview.html",
      "!**/node_modules/**",
      "!**/.git/**",
      "!**/.pnpm-store/**"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/img/android-chrome-256x256.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/assets/img/favicon.ico",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "icon": "public/assets/img/favicon.ico",
      "category": "Network;InstantMessaging;Chat;"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/assets/img/favicon.ico",
      "uninstallerIcon": "public/assets/img/favicon_unread.ico",
      "installerHeaderIcon": "public/assets/img/favicon.ico",
      "license": "LICENSE",
      "language": 1033
    },
    "portable": {
      "splashImage": "public/assets/img/android-chrome-192x192.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "morethanwords",
        "repo": "tweb",
        "channel": "latest"
      }
    ],
    "extraResources": [
      {
        "from": "public/assets/",
        "to": "assets/"
      },
      {
        "from": "assets/",
        "to": "app-assets/"
      }
    ],
    "extends": null
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-bold": "3.28.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-document": "3.28.0",
    "@tiptap/extension-hard-break": "3.28.0",
    "@tiptap/extension-italic": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-strike": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/extension-text": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "@tiptap/extensions": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@tonconnect/ui": "3.0.2",
    "temml": "^0.13.3"
  }
}
