# Sreymara Bot — environment configuration
# Copy to sreymara-bot/.env and fill in real values.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Telegram user id of the executive admin (receives registration + payout alerts,
# and unlocks the Admin Executive Panel). Get yours from @userinfobot.
ADMIN_ID=0

# Optional: channel/group id for scam/leak alerts (existing feature)
ADMIN_CHANNEL_ID=0

# Google Gemini API key for the Sreymara AI assistant (gemini-1.5-flash)
GEMINI_API_KEY=

# Public HTTPS URL of the Telegram Mini App (cinema + watch-to-earn).
# Must be reachable by Telegram clients and CORS-permitted to call the bot API.
MINI_APP_URL=https://your-domain.example/miniapp/index.html

# Bot @username (without the @) used to build viral referral deep-links
# (https://t.me/<BOT_USERNAME>?start=ref_<id>). If left blank the bot resolves it
# automatically from getMe() at startup, so this is optional.
BOT_USERNAME=
